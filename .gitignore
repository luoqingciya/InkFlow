# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# 虚拟环境
.venv/
venv/
env/

# 工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# pytest 的 --basetemp 落地目录（本机跑测试时会临时用到）
.pt_*/
.pytest_tmp*/

# ---------------------------------------------------------------- Node / Electron
node_modules/
desktop/out/
desktop/dist/
desktop/release/
desktop/build-*/
desktop/.asar-tmp/
# electron-vite 运行时会生成带时间戳的配置副本
desktop/electron.vite.config.*.mjs
.electron-vite/
*.tsbuildinfo
# 浏览器桥冒烟测试的编译产物（npm run smoke:bridge 每次重新生成）
desktop/scripts/.bridge-smoke.cjs

# 打包时临时放入的 Python 后端（由 CI 从 dist/ 拷入，不入库）
desktop/resources/backend/
!desktop/resources/backend/.gitkeep

# PyInstaller 中间产物
*.manifest
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------- InkFlow 运行时数据
# 用户数据目录不在仓库内（~/.inkflow），这里兜底排除误建的同名目录
.inkflow/
*.db
*.db-journal
*.db-wal
*.db-shm

# 下载产物
downloads/
exports/

# 本地配置（config.example.toml 是模板，真实配置不入库）
config.toml
config.local.toml

# ---------------------------------------------------------------- 书源
# 社区书源与用户导入书源不入库，仅保留目录占位与测试夹具
sources/community/*.json
sources/community/*.js
!sources/community/.gitkeep
sources/local/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- AI 助手工作数据
# WorkBuddy 的项目数据目录（工作记忆、任务状态）。属于本机工作痕迹，
# 不是项目产物，不进仓库。
.workbuddy-ai/
