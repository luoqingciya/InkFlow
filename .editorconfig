root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,json5,yaml,yml,toml}]
indent_size = 2

[*.{js,mjs,cjs,ts,mts,cts,vue,tsx,jsx,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
